# ==============================================================================
# EduSaaS - Variables d'Environnement (Exemple / Template)
# ==============================================================================
# Copiez ce fichier vers .env.local et renseignez vos véritables clés Supabase :
# cp .env.example .env.local

# URL publique de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé anonyme publique Supabase (Safe pour le client / navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Clé de service Supabase (STRICTEMENT PRIVÉE - Uniquement utilisée côté serveur)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# URL publique de l'application (pour redirections d'auth et callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
